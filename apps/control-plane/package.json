{
  "name": "control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "build:check-no-harness": "vp build && node scripts/assert-no-harness.mjs",
    "check": "vp check",
    "db:migrate:local": "wrangler d1 migrations apply VAULT_DB --local && wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply VAULT_DB --remote && wrangler d1 migrations apply AUTH_DB --remote",
    "deploy": "vp build && node scripts/assert-no-harness.mjs && wrangler deploy -c dist/server/wrangler.json",
    "dev": "vp dev",
    "e2e": "node --experimental-strip-types e2e/boot.e2e.ts",
    "preview": "vp preview",
    "test": "vp test",
    "types": "wrangler types"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.2",
    "@env-vault/crypto": "workspace:*",
    "@env-vault/protocol": "workspace:*",
    "@env-vault/vault-store": "workspace:*",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "cn": "catalog:",
    "lucide-react": "1.41.0",
    "radix-ui": "catalog:",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "shadcn": "catalog:",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.129.0"
  }
}
